# 注：不要把 NODE_ENV 写在这里。Vite 只把 VITE_ 开头的变量注入客户端，
# NODE_ENV 不生效（键名会退化成 undefined），且 Vite 会给出
# “NODE_ENV=xxx is not supported in the .env file” 告警。
# 代码里取当前环境请用 import.meta.env.MODE。
VITE_APP_TITLE = '管理后台'
VITE_BASE_URL = 'https://dev.api.com'
# 前端静态资源与路由的 base 路径（根路径部署）
VITE_PUBLIC_PATH = '/'
# 后端接口前缀（server.servlet.context-path），与前端 base 必须区分开，
# 否则 Vite 代理会把前端页面请求一并转发到后端造成 404
VITE_API_PREFIX = '/xd11cc'
VITE_WS_URL = 'wss://dev.api.com'
VITE_WS_PATH = '/ws'
